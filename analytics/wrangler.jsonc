{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "zezhouyang-visitors",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGIN": "https://zezhouyang.github.io",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zezhouyang-visitors",
      "database_id": "4e481ea3-b43b-4600-a7ad-75a7256bc905",
      "migrations_dir": "migrations",
    },
  ],
  "triggers": {
    "crons": ["41 3 * * *"],
  },
  "observability": {
    "enabled": false,
  },
}
